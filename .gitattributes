* text=auto eol=lf

*.md    text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.geojson text eol=lf

*.jpg   binary
*.png   binary
*.webp  binary
*.ico   binary
*.webm  binary

# Bundles generados por Vite y empaquetados de las demos: GitHub Linguist los
# marca como generados para que no dominen la barra de lenguajes. No se
# reclasifica ningún lenguaje ni se oculta código propio.
dist/dashboards/*/app.js    linguist-generated=true
dist/dashboards/*/app.css   linguist-generated=true
dist/dashboards/*/index.html linguist-generated=true

# Librerías de terceros servidas localmente, no escritas en este repositorio.
dist/dashboards/*/vendor/*  linguist-vendored=true
